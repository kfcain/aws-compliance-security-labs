{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kfcain/aws-compliance-security-labs/labs/catalog.schema.json",
  "title": "AWS Compliance & Security Labs portfolio catalog",
  "type": "object",
  "required": ["portfolio", "version", "labs"],
  "properties": {
    "$schema": { "type": "string" },
    "portfolio": { "const": "aws-compliance-security-labs" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string" },
    "scf_api": { "type": "string", "format": "uri" },
    "architecture_pattern": { "type": "string" },
    "source_repos_owner": { "type": "string" },
    "labs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "title", "repo_name", "path", "summary", "primary_risk",
          "scf_controls", "ksi", "frameworks", "aws_services", "source_repo",
          "status"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^\\d{2}-[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 3 },
          "repo_name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
          "path": { "type": "string", "pattern": "^labs/\\d{2}-[a-z0-9-]+$" },
          "summary": { "type": "string", "minLength": 10 },
          "primary_risk": { "type": "string", "minLength": 10 },
          "scf_controls": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[A-Z]{2,4}-\\d{2}(\\.\\d+)?$" }
          },
          "ksi": {
            "type": "array",
            "items": { "type": "string", "pattern": "^KSI-[A-Z]{3}-[A-Z]{3}$" }
          },
          "frameworks": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
          },
          "aws_services": { "type": "array", "items": { "type": "string" } },
          "external_services": { "type": "array", "items": { "type": "string" } },
          "source_repo": { "type": "string", "format": "uri" },
          "pages": { "type": "string", "format": "uri" },
          "status": { "enum": ["skeleton", "functional", "hardened"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
